  "fts": {
    "available": "\u53ef\u9009\uff1a\u5f15\u64ce\u4e0d\u652f\u6301 FTS5 \u6216 trigram \u65f6\u6574\u6bb5\u8df3\u8fc7\uff0c\u68c0\u7d22\u9000\u5316\u4e3a LIKE",
    "virtual_table": "questions_fts",
    "tokenizer": "trigram",
    "content_table": "questions",
    "indexed_columns": [
      "stem",
      "analysis"
    ],
    "shadow_tables_are_internal": true,
    "triggers": [
      "questions_fts_ai",
      "questions_fts_ad",
      "questions_fts_au"
    ],
    "statements": [
      "CREATE VIRTUAL TABLE questions_fts USING fts5(stem, analysis, content='questions', content_rowid='rowid', tokenize='trigram')",
      "CREATE TRIGGER questions_fts_ad AFTER DELETE ON questions BEGIN INSERT INTO questions_fts(questions_fts, rowid, stem, analysis) VALUES ('delete', old.rowid, old.stem, old.analysis); END",
      "CREATE TRIGGER questions_fts_ai AFTER INSERT ON questions BEGIN INSERT INTO questions_fts(rowid, stem, analysis) VALUES (new.rowid, new.stem, new.analysis); END",
      "CREATE TRIGGER questions_fts_au AFTER UPDATE ON questions BEGIN INSERT INTO questions_fts(questions_fts, rowid, stem, analysis) VALUES ('delete', old.rowid, old.stem, old.analysis); INSERT INTO questions_fts(rowid, stem, analysis) VALUES (new.rowid, new.stem, new.analysis); END"
    ]
  },
