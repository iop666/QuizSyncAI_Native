{"step":1,"title":"配对拿 token","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"$pairingCode","device_id":"android-device-1","device_name":"Pixel 7","platform":"android","app_version":"1.0.0"}}},"expect":{"status":200,"capture":{"token":"$.token"}}}
{"step":2,"title":"客户端版本同主版本（1.9.9 vs 主机 1.0.0）→ 放行：只比主版本","do":{"http":{"method":"GET","path":"/api/v1/info","auth":"none","headers":{"X-QS-Client-Version":"1.9.9"}}},"expect":{"status":200,"json":{"protocol_version":1}}}
{"step":3,"title":"客户端主版本不同（0.9.0）→ 426 version_mismatch","do":{"http":{"method":"GET","path":"/api/v1/info","auth":"none","headers":{"X-QS-Client-Version":"0.9.0"}}},"expect":{"status":426,"json":{"code":"version_mismatch"}}}
{"step":4,"title":"版本头不可解析（abc）→ 426 version_mismatch（**只有完全不带该头才放行**，见 auth 组第 23 步）","do":{"http":{"method":"GET","path":"/api/v1/info","auth":"none","headers":{"X-QS-Client-Version":"abc"}}},"expect":{"status":426,"json":{"code":"version_mismatch"}}}
{"step":5,"title":"Authorization 里令牌为空 → 401 unauthorized（缺 token）","do":{"http":{"method":"GET","path":"/api/v1/collections","auth":"empty"}},"expect":{"status":401,"json":{"code":"unauthorized"}}}
{"step":6,"title":"Authorization 没有 Bearer 前缀 → 401 unauthorized","do":{"http":{"method":"GET","path":"/api/v1/collections","auth":"malformed"}},"expect":{"status":401,"json":{"code":"unauthorized"}}}
{"step":7,"title":"请求体不是合法 JSON → 400 invalid_request","do":{"http":{"method":"POST","path":"/api/v1/sync/ops","auth":"device","raw":"{not json"}},"expect":{"status":400,"json":{"code":"invalid_request"}}}
{"step":8,"title":"合法 JSON 但缺 ops 字段 → 400 invalid_request","do":{"http":{"method":"POST","path":"/api/v1/sync/ops","auth":"device","json":{"nope":true}}},"expect":{"status":400,"json":{"code":"invalid_request"}}}
{"step":9,"title":"JSON 是数组而不是对象 → 400 invalid_request","do":{"http":{"method":"POST","path":"/api/v1/sync/ops","auth":"device","json":[1,2,3]}},"expect":{"status":400,"json":{"code":"invalid_request"}}}
{"step":10,"title":"上传必须是 multipart/form-data：用 JSON 体打上传口 → 400 invalid_request","do":{"http":{"method":"POST","path":"/api/v1/images","auth":"device","json":{"file":"nope"}}},"expect":{"status":400,"json":{"code":"invalid_request"}}}
{"step":11,"title":"图片下载的 hash 白名单只认小写：大写十六进制 → 404","do":{"http":{"method":"GET","path":"/api/v1/images/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","auth":"device"}},"expect":{"status":404,"json":{"code":"not_found"}}}
{"step":12,"title":"设备列表可以读，但响应里**绝不能**出现令牌哈希（只存哈希、且不回传）","do":{"http":{"method":"GET","path":"/api/v1/devices","auth":"device"}},"expect":{"status":200,"json":{},"json_absent":["$.devices[0].token_hash","$.token_hash"]}}
{"step":13,"title":"不存在的路由 → 404（框架级 404，不是本协议的 JSON 错误体）","do":{"http":{"method":"GET","path":"/api/v1/no-such-endpoint","auth":"device"}},"expect":{"status":404}}
{"step":14,"title":"合集选择：不存在的合集 id → 404 not_found","do":{"http":{"method":"POST","path":"/api/v1/collections/no-such-id/select","auth":"device"}},"expect":{"status":404,"json":{"code":"not_found"}}}
