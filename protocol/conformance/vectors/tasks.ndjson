{"step":1,"title":"配对拿 token","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"$pairingCode","device_id":"android-device-1","device_name":"Pixel 7","platform":"android","app_version":"1.0.0"}}},"expect":{"status":200,"capture":{"token":"$.token"}}}
{"step":2,"title":"主机已新建并选中一个合集（任务必须落在合集里）","do":{"seed":{"collection":{"id":"c1","name":"期末复习"},"active_collection":"c1"}}}
{"step":3,"title":"缺 task_id → 400 invalid_request","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"device","json":{"image_hash":"h-1","source_device":"android-device-1"}}},"expect":{"status":400,"json":{"code":"invalid_request"}}}
{"step":4,"title":"7 页超过硬上限 6 → 400 too_many_pages","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"device","json":{"task_id":"t-0","image_hash":"h-1","source_device":"android-device-1","image_hashes":["h-1","h-2","h-3","h-4","h-5","h-6","h-7"]}}},"expect":{"status":400,"json":{"code":"too_many_pages"}}}
{"step":5,"title":"页图还没上传 → 400 invalid_request","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"device","json":{"task_id":"t-0","image_hash":"h-1","source_device":"android-device-1"}}},"expect":{"status":400,"json":{"code":"invalid_request"}}}
{"step":6,"title":"先上传这一页（4KB）","do":{"http":{"method":"POST","path":"/api/v1/images","auth":"device","multipart":{"field":"file","bytes":4096,"filename":"q.jpg"}}},"expect":{"status":200,"json":{"existed":false},"capture":{"hash":"$.image_hash"}}}
{"step":7,"title":"指定的合集不存在 → 409 no_active_collection","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"device","json":{"task_id":"t-0","image_hash":"$hash","source_device":"android-device-1","collection_id":"no-such-collection"}}},"expect":{"status":409,"json":{"code":"no_active_collection"}}}
{"step":8,"title":"正常建任务 → 202（Accepted，不是 200），状态 queued，并给出这次识别的会话 id","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"device","json":{"task_id":"t-1","image_hash":"$hash","source_device":"android-device-1"}}},"expect":{"status":202,"json":{"status":"queued","question_count":0,"cached":false},"json_regex":{"session_id":"^[0-9a-f-]{36}$"},"capture":{"session_id":"$.session_id"}}}
{"step":9,"title":"轮询任务直到 done：任务视图只有 task_id/status/session_id/error_*/session，题目数在 session 里","do":{"poll":{"method":"GET","path":"/api/v1/tasks/t-1","auth":"device","until":{"status":"done"},"max_ms":20000,"interval_ms":100}},"expect":{"status":200,"json":{"status":"done","session_id":"$session_id","error_code":null,"session":{"session_id":"$session_id","question_count":1,"status":"done"}}}}
{"step":10,"title":"同一个 task_id 再提一次 → 幂等：返回既有状态（同样 202），不重复识别","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"device","json":{"task_id":"t-1","image_hash":"$hash","source_device":"android-device-1"}}},"expect":{"status":202,"json":{"status":"done","session_id":"$session_id","cached":true}}}
{"step":11,"title":"换 task_id、同一张图同一页序 → 直接复用既有会话（不重复调用 AI），cached 恒为 true","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"device","json":{"task_id":"t-2","image_hash":"$hash","source_device":"android-device-1"}}},"expect":{"status":202,"json":{"status":"done","session_id":"$session_id","cached":true}}}
{"step":12,"title":"不存在的任务 → 404 not_found","do":{"http":{"method":"GET","path":"/api/v1/tasks/no-such-task","auth":"device"}},"expect":{"status":404,"json":{"code":"not_found"}}}
{"step":13,"title":"给不存在的任务重试 → 404 not_found","do":{"http":{"method":"POST","path":"/api/v1/tasks/no-such-task/retry","auth":"device"}},"expect":{"status":404,"json":{"code":"not_found"}}}
{"step":14,"title":"主机队列里已经有 20 条排队任务（上限）","do":{"seed":{"queued_tasks":20}}}
{"step":15,"title":"队列满 → 429 queue_full（带 retry_after_seconds）","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"device","json":{"task_id":"t-3","image_hash":"$hash","source_device":"android-device-1"}}},"expect":{"status":429,"json":{"code":"queue_full"},"json_regex":{"retry_after_seconds":"^[0-9]+$"}}}
{"step":16,"title":"重新生成：按既有会话的页序强制重跑 → 202，且响应必须带 task_id 与新的 session_id","do":{"http":{"method":"POST","path":"/api/v1/sessions/$session_id/reanalyze","auth":"device"}},"expect":{"status":202,"json":{"status":"queued","question_count":null,"cached":false},"json_regex":{"task_id":"^[0-9a-f-]{36}$","session_id":"^[0-9a-f-]{36}$"},"capture":{"reanalyze_task":"$.task_id","reanalyze_session":"$.session_id"}}}
{"step":17,"title":"重跑出来的新任务也能查到并跑到 done（队列满不影响重跑：队列闸门在创建端点上）","do":{"poll":{"method":"GET","path":"/api/v1/tasks/$reanalyze_task","auth":"device","until":{"status":"done"},"max_ms":30000,"interval_ms":150}},"expect":{"status":200,"json":{"status":"done","session_id":"$reanalyze_session"}}}
{"step":18,"title":"给不存在的会话重新生成 → 404 not_found","do":{"http":{"method":"POST","path":"/api/v1/sessions/no-such-session/reanalyze","auth":"device"}},"expect":{"status":404,"json":{"code":"not_found"}}}
