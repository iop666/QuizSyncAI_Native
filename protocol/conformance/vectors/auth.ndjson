{"step":1,"title":"/info 无需鉴权：自述设备身份、协议版本与能力（capabilities 顺序不是契约）","do":{"http":{"method":"GET","path":"/api/v1/info","auth":"none"}},"expect":{"status":200,"json":{"device_id":"server-device-1","device_name":"TEST-HOST","platform":"windows","protocol_version":1,"app_version":"1.0.0","ai_configured":true,"active_collection_id":null},"json_contains":{"capabilities":["analyze","sync","image_fetch","collections","multipage"]}}}
{"step":2,"title":"缺 token → 401 unauthorized","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"none","json":{"task_id":"t-1","image_hash":"h-1","source_device":"android-device-1"}}},"expect":{"status":401,"json":{"code":"unauthorized"}}}
{"step":3,"title":"token 认不出 → 401 unauthorized（与『缺少 token』同码不同 message）","do":{"http":{"method":"POST","path":"/api/v1/tasks","auth":"bogus","json":{"task_id":"t-1","image_hash":"h-1","source_device":"android-device-1"}}},"expect":{"status":401,"json":{"code":"unauthorized"}}}
{"step":4,"title":"配对码错误 → 401 invalid_code","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"000000","device_id":"android-device-1","device_name":"Pixel 7","platform":"android","app_version":"1.0.0"}}},"expect":{"status":401,"json":{"code":"invalid_code"}}}
{"step":5,"title":"配对码正确 → 200，签发 64 位十六进制 token","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"$pairingCode","device_id":"android-device-1","device_name":"Pixel 7","platform":"android","app_version":"1.0.0"}}},"expect":{"status":200,"json":{"server_device_id":"server-device-1","server_name":"TEST-HOST","protocol_version":1},"json_regex":{"token":"^[0-9a-f]{64}$"},"capture":{"token":"$.token"}}}
{"step":6,"title":"带 token 读合集列表（空库）→ 200","do":{"http":{"method":"GET","path":"/api/v1/collections","auth":"device"}},"expect":{"status":200,"json":{"collections":[],"active_collection_id":null}}}
{"step":7,"title":"配对码过期（TTL 5 分钟）→ 401 code_expired","do":{"clock":{"advance_ms":300001}}}
{"step":8,"title":"（上一步只推进时钟）用过期码配对 → 401 code_expired","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"$pairingCode","device_id":"android-device-2","device_name":"Pixel 8","platform":"android","app_version":"1.0.0"}}},"expect":{"status":401,"json":{"code":"code_expired"}}}
{"step":9,"title":"刷新配对码（等价 UI 上的『刷新』）","do":{"server":{"refresh_pairing_code":true}}}
{"step":10,"title":"同一 device_id 重新配对 → 409 already_paired，但 body 里照样给新 token","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"$pairingCode","device_id":"android-device-1","device_name":"Pixel 7","platform":"android","app_version":"1.0.0"}}},"expect":{"status":409,"json":{"already_paired":true,"server_device_id":"server-device-1"},"capture":{"token2":"$.token"}}}
{"step":11,"title":"重新配对后旧 token 立刻失效 → 401 unauthorized","do":{"http":{"method":"GET","path":"/api/v1/collections","auth":"device"}},"expect":{"status":401,"json":{"code":"unauthorized"}}}
{"step":12,"title":"新 token 可用 → 200","do":{"http":{"method":"GET","path":"/api/v1/collections","auth":"device:token2"}},"expect":{"status":200,"json":{"collections":[]}}}
{"step":13,"title":"把时钟推过限流窗口（60 秒）","do":{"clock":{"advance_ms":61000}}}
{"step":14,"title":"窗口内第 1 次尝试：错误配对码 → 401 invalid_code","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"111111","device_id":"android-device-3","device_name":"x","platform":"android","app_version":"1.0.0"}}},"expect":{"status":401,"json":{"code":"invalid_code"}}}
{"step":15,"title":"第 2 次 → 401","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"111111","device_id":"android-device-3","device_name":"x","platform":"android","app_version":"1.0.0"}}},"expect":{"status":401,"json":{"code":"invalid_code"}}}
{"step":16,"title":"第 3 次 → 401","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"111111","device_id":"android-device-3","device_name":"x","platform":"android","app_version":"1.0.0"}}},"expect":{"status":401,"json":{"code":"invalid_code"}}}
{"step":17,"title":"第 4 次 → 401","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"111111","device_id":"android-device-3","device_name":"x","platform":"android","app_version":"1.0.0"}}},"expect":{"status":401,"json":{"code":"invalid_code"}}}
{"step":18,"title":"第 5 次 → 401（每分钟上限 5 次，这一发刚好用满）","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"111111","device_id":"android-device-3","device_name":"x","platform":"android","app_version":"1.0.0"}}},"expect":{"status":401,"json":{"code":"invalid_code"}}}
{"step":19,"title":"第 6 次 → 429 rate_limited（带 retry_after_seconds）","do":{"http":{"method":"POST","path":"/api/v1/pair","auth":"none","json":{"code":"111111","device_id":"android-device-3","device_name":"x","platform":"android","app_version":"1.0.0"}}},"expect":{"status":429,"json":{"code":"rate_limited"},"json_regex":{"retry_after_seconds":"^[0-9]+$"}}}
{"step":20,"title":"吊销设备（v1 里任何已配对设备都能调）→ 200","do":{"http":{"method":"DELETE","path":"/api/v1/devices/android-device-1","auth":"device:token2"}},"expect":{"status":200,"json":{"revoked":"android-device-1"}}}
{"step":21,"title":"被吊销的 token → 401 revoked（与 unauthorized 区分）","do":{"http":{"method":"GET","path":"/api/v1/collections","auth":"device:token2"}},"expect":{"status":401,"json":{"code":"revoked"}}}
{"step":22,"title":"客户端主版本不同 → 426 version_mismatch","do":{"http":{"method":"GET","path":"/api/v1/info","auth":"none","headers":{"X-QS-Client-Version":"2.0.0"}}},"expect":{"status":426,"json":{"code":"version_mismatch"}}}
{"step":23,"title":"不带版本头 → 放行（老客户端与手工 curl 不被挡在门外）","do":{"http":{"method":"GET","path":"/api/v1/info","auth":"none"}},"expect":{"status":200,"json":{"protocol_version":1}}}
