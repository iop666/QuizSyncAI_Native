<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuizSync.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI 双端搜题">
    <!--
      窗口内容 = 自定义标题栏 + 页面宿主。
      样式取值一律走共享 token（App.xaml 合并的 DesignTokens.xaml，
      与 Android 的 QsTokens 同源，值来自老应用 1.1.0 的视觉契约 packages/quizsync_ui）。

      ⚠️ 加了标题栏之后 **Window.Content 是 Grid 而不是 Frame** ——
      找 RootFrame 一律走 MainWindow.ShellFrame，不要再写 `Content is Frame`
      （那种写法会**静默**失效：托盘菜单、切合集、剪贴板入口都会「点了没反应」）。

      标题栏是 WinAppSDK 1.7 的原生 TitleBar 控件；ExtendsContentIntoTitleBar + SetTitleBar
      在 MainWindow.xaml.cs 的 ApplyTitleBar() 里接（含 IsCustomizationSupported 兜底）。
    -->
    <!-- 外壳根透明：让 Mica 背板能真正合成出来（原先这里铺不透明 QsCanvasBrush，
         背板被完全盖住 —— 复核用「平移窗口 A/B 采样」实证过：移动 520x260 物理像素后
         颜色一字不变，DWMWA_SYSTEMBACKDROP_TYPE 恒为 0(Auto)）。
         页面内容区仍由各 Page 自己铺不透明底色，可读性不变。 -->
    <Grid x:Name="ShellRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
        Background="Transparent"
            Grid.Row="0"
            Title="AI 双端搜题">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/app_icon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame
            x:Name="RootFrame"
            Grid.Row="1"
            Background="Transparent" />
    </Grid>
</Window>
