<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="QuizSync.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 跨端设计 token（与 Android 的 QsTokens 同源，由 tools/gen_design_tokens.py 生成）。
                     必须排在 XamlControlsResources **之后**：同一层里后合并的字典先被查到，
                     这样品牌紫与描边色才能真正覆盖框架默认值。 -->
                <ResourceDictionary Source="ms-appx:///DesignTokens.xaml" />
                <!-- 外壳样式（顶栏 / 侧栏 / 药丸 / 卡片）。排在 token 之后，
                     这样它里面引用 ThemeResource 时拿到的是品牌色。 -->
                <ResourceDictionary Source="ms-appx:///Theme/ShellStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/ShellLayout.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
