<?xml version="1.0" encoding="utf-8"?>
<!-- 本文件由 tools/gen_design_tokens.py 从 design/tokens.json 生成，请勿手改。
     校验：跑一次 tools/gen_design_tokens.py，加参数 check。
     值来自老应用（1.1.0）的视觉契约 packages/quizsync_ui，不要在这里手改数值。
     字号阶 / 间距 / 圆角 / 动效四节是 P1 新增的（1.1.0 没有对应物），自检写在 tools/gen_design_tokens.py 里。

     生成时逐条校验过的 WCAG 对比度：
     主按钮文字 / 填充: 6.48:1（下限 4.5:1）
     主按钮文字 / 填充（暗）: 7.73:1（下限 4.5:1）
     正文 / 卡片: 17.10:1（下限 4.5:1）
     正文 / 卡片（暗）: 14.33:1（下限 4.5:1）
     次要文字 / 页面底色: 8.51:1（下限 4.5:1）
     次要文字 / 页面底色（暗）: 11.14:1（下限 4.5:1）
     标签描边 / 卡片: 4.48:1（下限 3.0:1）
     标签描边 / 卡片（暗）: 5.83:1（下限 3.0:1）
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="QsBrandPrimaryBrush" Color="#FF35693E"/>
            <SolidColorBrush x:Key="QsOnBrandPrimaryBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="QsBrandSeedBrush" Color="#FF16A34A"/>
            <SolidColorBrush x:Key="QsCanvasBrush" Color="#FFF3F5F4"/>
            <SolidColorBrush x:Key="QsSurfaceBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="QsOnSurfaceBrush" Color="#FF181D18"/>
            <SolidColorBrush x:Key="QsOnSurfaceVariantBrush" Color="#FF414941"/>
            <SolidColorBrush x:Key="QsOutlineBrush" Color="#FF727970"/>
            <SolidColorBrush x:Key="QsCardStrokeBrush" Color="#FFE3E7E5"/>
            <!-- AccentButtonStyle 的交互态一起跟着 token 走 -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF35693E"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF35693E" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF35693E" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF35693E" Opacity="0.4"/>
            <Color x:Key="SystemAccentColor">#FF35693E</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="QsBrandPrimaryBrush" Color="#FF9CD4A0"/>
            <SolidColorBrush x:Key="QsOnBrandPrimaryBrush" Color="#FF003914"/>
            <SolidColorBrush x:Key="QsBrandSeedBrush" Color="#FF16A34A"/>
            <SolidColorBrush x:Key="QsCanvasBrush" Color="#FF0F1113"/>
            <SolidColorBrush x:Key="QsSurfaceBrush" Color="#FF101510"/>
            <SolidColorBrush x:Key="QsOnSurfaceBrush" Color="#FFE0E4DB"/>
            <SolidColorBrush x:Key="QsOnSurfaceVariantBrush" Color="#FFC1C9BE"/>
            <SolidColorBrush x:Key="QsOutlineBrush" Color="#FF8B9389"/>
            <SolidColorBrush x:Key="QsCardStrokeBrush" Color="#FF2A2F33"/>
            <!-- AccentButtonStyle 的交互态一起跟着 token 走 -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF9CD4A0"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF9CD4A0" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF9CD4A0" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF9CD4A0" Opacity="0.4"/>
            <Color x:Key="SystemAccentColor">#FF9CD4A0</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="QsBrandPrimaryBrush" Color="#FF35693E"/>
            <SolidColorBrush x:Key="QsOnBrandPrimaryBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="QsBrandSeedBrush" Color="#FF16A34A"/>
            <SolidColorBrush x:Key="QsCanvasBrush" Color="#FFF3F5F4"/>
            <SolidColorBrush x:Key="QsSurfaceBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="QsOnSurfaceBrush" Color="#FF181D18"/>
            <SolidColorBrush x:Key="QsOnSurfaceVariantBrush" Color="#FF414941"/>
            <SolidColorBrush x:Key="QsOutlineBrush" Color="#FF727970"/>
            <SolidColorBrush x:Key="QsCardStrokeBrush" Color="#FFE3E7E5"/>
            <!-- AccentButtonStyle 的交互态一起跟着 token 走 -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF35693E"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF35693E" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF35693E" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF35693E" Opacity="0.4"/>
            <Color x:Key="SystemAccentColor">#FF35693E</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ================= 间距 / 圆角 ================= -->
    <x:Double x:Key="QsSpaceXxs">2</x:Double>
    <x:Double x:Key="QsSpaceXs">4</x:Double>
    <x:Double x:Key="QsSpaceSm">8</x:Double>
    <x:Double x:Key="QsSpaceMd">12</x:Double>
    <x:Double x:Key="QsSpaceLg">16</x:Double>
    <x:Double x:Key="QsSpaceXl">24</x:Double>

    <x:Double x:Key="QsDimHairline">1</x:Double>
    <x:Double x:Key="QsDimStrokeEmphasis">2</x:Double>
    <x:Double x:Key="QsDimStrokeMarker">4</x:Double>
    <x:Double x:Key="QsDimIconXs">12</x:Double>
    <x:Double x:Key="QsDimIconBase">16</x:Double>
    <x:Double x:Key="QsDimIconSm">18</x:Double>
    <x:Double x:Key="QsDimIconMd">20</x:Double>
    <x:Double x:Key="QsDimIconLg">22</x:Double>
    <x:Double x:Key="QsDimIconXl">32</x:Double>
    <x:Double x:Key="QsDimIconBox">38</x:Double>
    <x:Double x:Key="QsDimStatusDot">7</x:Double>
    <x:Double x:Key="QsDimStatusDotSm">5</x:Double>
    <x:Double x:Key="QsDimTouchTarget">48</x:Double>
    <x:Double x:Key="QsDimSessionBarHeight">46</x:Double>
    <x:Double x:Key="QsDimHeaderRowHeight">46</x:Double>
    <x:Double x:Key="QsDimStateBadge">68</x:Double>
    <x:Double x:Key="QsDimProgressStroke">2.5</x:Double>
    <x:Double x:Key="QsDimSliderLabelWidth">78</x:Double>
    <x:Double x:Key="QsDimSliderValueWidth">52</x:Double>
    <x:Double x:Key="QsDimBottomBarClearance">88</x:Double>

    <CornerRadius x:Key="QsRadiusCard">16</CornerRadius>
    <CornerRadius x:Key="QsRadiusControl">10</CornerRadius>
    <CornerRadius x:Key="QsRadiusChip">999</CornerRadius>

    <!-- 卡片内边距 -->
    <Thickness x:Key="QsPadCard">24</Thickness>

    <!-- ================= 字号阶 =================
         重构前这里散落 14 种字号字面量（11 / 11.5 / 12 / 12.5 / 13 / 13.5 / 14 / 14.5 / 15 / 16 / 18 / 20 / 26 / 32），
         其中带小数的几个是从 1.1.0 的 Flutter 源码搬过来的像素对齐值，原生排版里没有意义。
         收敛成 QsCaption / QsBody / QsBodyStrong / QsSubtitle / QsTitle / QsTitleLarge 六档，
         **页面里不再允许出现裸 FontSize**。 -->
    <!-- 字号数值（给「只换数不改别的」的地方用，见本节说明） -->
    <x:Double x:Key="QsFontSizeMicro">10</x:Double>
    <x:Double x:Key="QsFontSizeCaptionSmall">11</x:Double>
    <x:Double x:Key="QsFontSizeCaption">12</x:Double>
    <x:Double x:Key="QsFontSizeBody">14</x:Double>
    <x:Double x:Key="QsFontSizeBodyStrong">14</x:Double>
    <x:Double x:Key="QsFontSizeSubtitle">16</x:Double>
    <x:Double x:Key="QsFontSizeTitle">20</x:Double>
    <x:Double x:Key="QsFontSizeTitleLarge">28</x:Double>

    <!-- 专供密集计数/角标（用户要求比 caption 更小一档）；正文不许用 -->
    <Style x:Key="QsMicroTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceVariantBrush}" />
    </Style>

    <!-- 密集元信息：侧栏计数、时间戳后缀 -->
    <Style x:Key="QsCaptionSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceVariantBrush}" />
    </Style>

    <!-- 辅助说明、时间戳、标签文字 -->
    <Style x:Key="QsCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceVariantBrush}" />
    </Style>

    <!-- 正文默认 -->
    <Style x:Key="QsBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
    </Style>

    <!-- 列表项主标题、需要强调的正文 -->
    <Style x:Key="QsBodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
    </Style>

    <!-- 卡片标题、设置分组标题 -->
    <Style x:Key="QsSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
    </Style>

    <!-- 页面标题（页头 / TopAppBar） -->
    <Style x:Key="QsTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
    </Style>

    <!-- 结果页大标题、空状态标题 -->
    <Style x:Key="QsTitleLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
    </Style>

    <!-- 正文尺寸（14）+ 次要色：说明文字、辅助行。-->
    <Style x:Key="QsSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QsBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceVariantBrush}" />
    </Style>

    <!-- ================= 动效 ================= -->
    <!-- 动效：时长上限 400ms、位移上限 24（tools/gen_design_tokens.py 会断言 —— 这两条上限就是「禁止无意义持续动画 / 页面乱飞」的机器版）。
         这里的值给 XAML 用；C# 请直接用 Theme/QsMotion.g.cs 的常量与工厂。 -->
    <x:Double x:Key="QsDurationMsFast">120</x:Double>
    <x:Double x:Key="QsDurationMsNormal">200</x:Double>
    <x:Double x:Key="QsDurationMsSlow">300</x:Double>

    <x:Double x:Key="QsDistanceEnter">8</x:Double>

    <x:String x:Key="QsEaseStandardPoints">0.2,0.0,0.0,1.0</x:String>
    <x:String x:Key="QsEaseDeceleratePoints">0.1,0.9,0.2,1.0</x:String>
    <x:String x:Key="QsEaseAcceleratePoints">0.9,0.1,1.0,0.2</x:String>

    <!-- 主按钮：圆角 10（AppRadius.control，M9 按 Fluent 观感收的值），品牌绿填充。
         第五轮教训：这里曾经被改成 999 胶囊，是往我凭空发明的规格上拉。 -->
    <Style x:Key="QsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource QsBrandPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnBrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsBrandPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- 能力标签：圆角 999（AppRadius.chip = 全胶囊），描边用 outline
         （**功能边界**要用 outline，不能用 cardStroke —— 后者对比度天生很低，是装饰用的）。 -->
    <Style x:Key="QsTagBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsOutlineBrush}" />
        <Setter Property="Background" Value="{ThemeResource QsSurfaceBrush}" />
    </Style>

    <!-- Fluent 卡片：圆角 16（AppRadius.card）+ 装饰描边（cardStroke）。 -->
    <Style x:Key="QsCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsCardStrokeBrush}" />
        <Setter Property="Background" Value="{ThemeResource QsSurfaceBrush}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- 底部状态条：通栏条带，底色 = 页面底色 canvas、文字 = 次要文字。 -->
    <Style x:Key="QsStatusBarBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsCardStrokeBrush}" />
        <Setter Property="Background" Value="{ThemeResource QsCanvasBrush}" />
    </Style>
</ResourceDictionary>
