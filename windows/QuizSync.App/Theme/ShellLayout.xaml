<?xml version="1.0" encoding="utf-8"?>
<!--
  外壳样式（与 Theme/ShellStyles.xaml 分开的理由是**编译器限制**，不是审美）：
  WinUI 的 XAML 编译器在同一个 ResourceDictionary 里同时出现
  `ResourceDictionary.ThemeDictionaries` 与 `Style` 时会**静默崩溃**（exit 1、不报任何错，
  事件日志里也没有记录）。实测：只有 ThemeDictionaries → 能编译；再加一个最朴素的
  `<Style TargetType="TextBlock"><Setter Property="FontSize" Value="18"/></Style>` → 立刻崩。
  拆成两个文件后两个都能编译。详见 docs/DECISIONS.md。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         字号（ui-spec-desktop §5.4）。WinUI 默认字体是 14，Flutter 默认 14，
         所以这里凡是「Material3 默认」的场合都直接沿用 WinUI 的默认值，
         不额外设 FontSize。
         =================================================================== -->

    <!-- AppBar 标题：18 / w700（app_theme.dart:78-82） -->
    <Style x:Key="QsAppBarTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QsFontBold}" />
                            <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 侧栏标题「历史记录」：titleSmall + w700（home_page.dart:715） -->
    <Style x:Key="QsSidebarTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QsFontBold}" />
                            <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
    </Style>

    <!-- 会话头时间：titleMedium + w600 -->
    <Style x:Key="QsSessionTimeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QsFontDemibold}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
    </Style>

    <!-- 通用正文 14（QsBodyTextStyle 在 DesignTokens.xaml 里，这里补字重版本） -->
    <Style x:Key="QsBodyDemiboldStyle" TargetType="TextBlock" BasedOn="{StaticResource QsBodyTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource QsFontDemibold}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="QsBodyBoldStyle" TargetType="TextBlock" BasedOn="{StaticResource QsBodyTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource QsFontBold}" />
                            <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- 药丸 / 次级小字 11.5（widgets.dart:94-102） -->
    <Style x:Key="QsPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QsFontDemibold}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 免责声明 / 把握率 / 时间：11 -->
    <Style x:Key="QsTinyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceVariantBrush}" />
    </Style>

    <!-- 列表项副标题：11.5 -->
    <Style x:Key="QsTileSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceVariantBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ===================================================================
         顶栏。1.1.0 是 Material AppBar：底色 surface、elevation 0、
         centerTitle false、底部 1px QuizSyncTheme.outline 描边
         （ui_pkg/src/app_theme.dart:71-84）。高度 Material 默认 56。
         =================================================================== -->
    <Style x:Key="QsAppBarBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="56" />
        <Setter Property="Background" Value="{ThemeResource QsSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsOutlineBrush}" />
    </Style>

    <!-- 顶栏图标按钮：Flutter IconButton 默认 48 命中区、图标 24；
         这里取 34×34 + 图标 18，避免顶栏显得笨重（1.1.0 顶栏图标视觉尺寸在 18–20）。 -->
    <Style x:Key="QsIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceVariantBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="QsIconFontStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- ===================================================================
         药丸 StatusPill。widgets.dart:94-102：字号 11.5 / w600 / height 1.2，
         filled 时底色 = color@12%、否则透明 + 1px 描边 color@55%；
         圆角 AppRadius.chip = 999（Flutter 的 StadiumBorder 语义 = 夹到半高）；
         内边距 水平 9 / 垂直 4。

         ⚠️ **故意不写 999**：WinUI 的 CornerRadius 不做这个夹取，半径超过半高时
         圆角矩形会**退化成椭圆**（用户当场指出过）。代码里统一走 Theme/PillShape.MakeCapsule
         按实测尺寸算半径；12 = 标准 24 高药丸的半高，是个安全的默认值。
         =================================================================== -->
    <Style x:Key="QsPillBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 顶栏两枚药丸（合集 / 热键）：padding 水平 9 / 垂直 4、圆角见上、边框 color@35% -->
    <Style x:Key="QsTopBarPillStyle" TargetType="Border" BasedOn="{StaticResource QsPillBorderStyle}">
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ===================================================================
         侧栏。
         =================================================================== -->
    <Style x:Key="QsSidebarBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="296" />
        <Setter Property="Background" Value="{ThemeResource QsSurfaceBrush}" />
    </Style>

    <!-- 会话列表项：Material(选中 primary@10%) + InkWell(圆角 10) + Container(padding 8)
         （home_page.dart:767-937）。这里用 Button 承载点击，样式对齐。 -->
    <Style x:Key="QsSessionTileStyle" TargetType="Button">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 侧栏底部「截屏搜题」：OutlinedButton，minimumSize height 40，图标 18。 -->
    <Style x:Key="QsOutlinedActionStyle" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsOutlineBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ===================================================================
         题目卡片。Card(圆角 16, 1px outline 描边, elevation 0, margin h14 v7)
         + Padding(18,16,18,16)。question_card.dart:48-59。
         =================================================================== -->
    <Style x:Key="QsQuestionCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsCardStrokeBrush}" />
        <Setter Property="Background" Value="{ThemeResource QsSurfaceBrush}" />
        <Setter Property="Padding" Value="18,16,18,16" />
        <Setter Property="Margin" Value="14,7,14,7" />
    </Style>

    <!-- 题号徽标：padding h9 v3、底色 primary、圆角同药丸（见上面 ⚠️，代码里走 PillShape）、
         字 11.5 / w700 / 白。10 = 标准 20 高徽标的半高。 -->
    <Style x:Key="QsQuestionNoBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource QsBrandPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 序号（不带点）：12.5 / w700 / primary -->
    <Style x:Key="QsQuestionSeqStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QsFontBold}" />
                            <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource QsBrandPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 解析块 / 材料块：圆角 10 + 1px 边框 -->
    <Style x:Key="QsInsetBlockStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource QsAnalysisBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsAnalysisStrokeBrush}" />
    </Style>

    <!-- ===================================================================
         底部导航条：Container(padding h12 v6, 底色 surface)（home_page.dart:1230-1276）
         =================================================================== -->
    <Style x:Key="QsNavBarBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,6,12,6" />
        <Setter Property="Background" Value="{ThemeResource QsSurfaceBrush}" />
    </Style>

    <Style x:Key="QsNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{ThemeResource QsOnSurfaceBrush}" />
    </Style>

    <!-- ===================================================================
          设置页（ui-spec-desktop §2.2 / §3.0）。

          ⚠️ 2.0 的 P3 之后，设置页左导航与每一行都换成了原生控件
          （NavigationView / Toolkit SettingsCard / InfoBar），原来那批 QsSettings* 样式
          （左导航项、页标题、页说明、组标题、行标题、行说明、数值、卡片、组标题带）
          已**全部 0 引用**，于 2026-09-27 删除 —— 别再从规格里抄回来：
          现在这些形态由 Pages/SettingsPrimitives.cs 的 SettingsUi 用原生控件表达。
          =================================================================== -->

    <!-- ===================================================================
         输入控件：填充 subtleFill、圆角 10、内边距 水平 14 / 垂直 14、
         聚焦边框 primary 1.6px（app_theme.dart:103-123）。
         =================================================================== -->
    <Style x:Key="QsTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource QsSubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 组合框 / 下拉：与输入框同一套观感 -->
    <Style x:Key="QsComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource QsSubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource QsCardStrokeBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="QsSliderStyle" TargetType="Slider">
        <!-- 滑块轨道高 4（app_theme.dart:196-199） -->
        <Setter Property="MinWidth" Value="180" />
    </Style>

    <!-- ===================================================================
         滚动条：恒可见、厚 8、圆角 4（app_theme.dart:208-212）。
         WinUI 的 ScrollBar 宽度由 ScrollBarSize 资源决定，这里覆盖。
         =================================================================== -->
    
    <!--
    <x:Double x:Key="ScrollBarSize">8</x:Double>
    <x:Double x:Key="ScrollBarVerticalThumbMinHeight">24</x:Double>
    <x:Double x:Key="ScrollBarHorizontalThumbMinWidth">24</x:Double>
    <CornerRadius x:Key="ScrollBarCornerRadius">4</CornerRadius>
    -->


</ResourceDictionary>
