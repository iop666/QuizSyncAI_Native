<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面。结构**完全照 1.1.0 的 HomePage**
  （soundcode/apps/desktop/lib/ui/home_page.dart:177-273），不是导航式外壳：

    Scaffold
    ├─ AppBar                        顶栏：logo + 项目名 + 合集药丸 + 热键药丸；右侧 4 个动作
    └─ Column
       ├─ [暂存页>0] _StagingBar     多页暂存条（只有攒了页才出现）
       └─ Row
          ├─ 296 → _SessionSidebar   历史记录侧栏
          ├─ VerticalDivider 1px
          └─ _ContentPane           会话头 / 题目卡片区 / 底部导航条

  逐项对照见 D:\DeepseekHarness\TemporaryConversationFile\phase0-e2e\ui-spec-desktop.md 第 1、2 节。
-->
<Page
    x:Class="QuizSync.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuizSync.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource QsCanvasBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             顶栏（home_page.dart:178-215）
             ============================================================ -->
        <Border Grid.Row="0" Style="{StaticResource QsAppBarBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- titleSpacing: 18；logo 26×26 圆角 7；标题 18/w700；
                     间距 10 → 合集药丸 → 10 → 热键药丸（后者 Flexible，可压缩） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,12,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/app_icon.png" Stretch="UniformToFill" />
                    </Border>

                    <TextBlock Text="QuizSync AI" Style="{StaticResource QsAppBarTitleStyle}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />

                    <!-- 合集药丸（home_page.dart:408-471）：底色 primary@10%、
                         圆角见 PillShape（**不能写 999**，WinUI 会画成椭圆）、
                         1px primary@35% 描边、内边距 水平 9 / 垂直 4。
                         药丸本体就是 Button —— 里面再套一层 Border 的话，
                         悬停时露出来的是 Button 自己那层底，半径对不上。 -->
                    <Button x:Name="CollectionPillButton" Margin="12,0,0,0" Padding="9,4,9,4"
                            BorderThickness="1" CornerRadius="12"
                            VerticalAlignment="Center" Click="OnCollectionPillClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <FontIcon x:Name="CollectionGlyph" FontSize="13" Glyph="&#xE8B7;" />
                            <TextBlock x:Name="CollectionLabel" Margin="5,0,0,0"
                                       Style="{StaticResource QsPillTextStyle}"
                                       MaxWidth="220" VerticalAlignment="Center" />
                            <FontIcon FontSize="15" Glyph="&#xE70D;" />
                        </StackPanel>
                    </Button>

                    <controls:StatusPill x:Name="HotkeyPill" Margin="10,0,0,0" VerticalAlignment="Center" />

                    <!-- 多页暂存指示（用户 2026-09-27 要求：把原来横在内容区上方那条暂存条
                         搬到这里、放在**热键药丸后面**；默认显示「单张识别」，
                         开启多页之后显示暂存内容）。

                         两个取舍：
                         ① 提示语（`Staging.Hint()`）放 **ToolTip** 而不是排在这一行里 ——
                            顶栏只有 32 逻辑像素高，塞进整句提示会把窗口窄时的标题挤没；
                            提示本身不丢，只是按需展开；
                         ② 「清空暂存区」按钮只在**多页模式下**出现（默认态藏起来）——
                            单张识别时它没有可清的东西，常驻就是一个不可用的按钮。 -->
                    <!-- `MinHeight=26`：默认态与多页态**同高** —— 多页态多一个 20×20 的清空按钮，
                             不钉住高度的话药丸会从约 20 涨到 26 逻辑像素，切换那一刻整行跳一下
                             （用户反馈「进入多页模式 UI 异常」的可见症状之一）。 -->
                        <!-- ⚠️ 这里**不能**写 `CornerRadius="{StaticResource QsRadiusChip}"`（=999）：
                                 WinUI 的 CornerRadius **不夹取**到半高，半径超过半高时圆角矩形会退化成
                                 **椭圆**（Flutter 的 StadiumBorder 才会自动夹）。默认态没有描边与底色
                                 所以看不出来，一进多页模式描边出现就成了椭圆 —— 用户报的「多页模式 UI 异常」
                                 就是这个。胶囊形由 `PillShape.MakeCapsule()` 按实测高度算（见 UpdateStagingBar）。 -->
                            <Border x:Name="StagingIndicator" Margin="10,0,0,0" VerticalAlignment="Center"
                                    MinHeight="26" Padding="9,3,4,3" BorderThickness="1"
                                    AutomationProperties.AutomationId="StagingIndicator">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="StagingGlyph" FontSize="13" Glyph="&#xE722;"
                                      Foreground="{ThemeResource QsOnSurfaceVariantBrush}" />
                            <TextBlock x:Name="StagingCount" FontSize="{StaticResource QsFontSizeCaption}"
                                       VerticalAlignment="Center" />
                            <!-- 显式给 20×20：`QsIconButtonStyle` 是固定 34×34，塞进约 22 逻辑像素高的药丸里
                                     会把药丸整个撑高 —— 那就是「进入多页模式后 UI 异常」的真因。 -->
                                <Button x:Name="ClearStagingButton" Style="{StaticResource QsIconButtonStyle}"
                                        Width="20" Height="20" Padding="0" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="ClearStagingButton"
                                    ToolTipService.ToolTip="清空多页暂存区" Click="OnClearStagingClick">
                                <FontIcon FontSize="12" Glyph="&#xE81E;"
                                          Style="{StaticResource QsIconFontStyle}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- actions：免责声明 + 导出当前合集 / 搜索历史题目 / 设置 + 右侧 10 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <!-- 常驻免责声明（SPEC §4.4：全应用范围内必须存在**一处**）。
                         用户 2026-09-27 要求：**移出内容区**，放到顶栏右上角功能按键**前面**。
                         三条实现细节：
                         ① 用**横向 StackPanel 而不是 WrapPanel**（用户反馈「感叹号和正文没对齐」）：
                            WrapPanel 把每个子元素按行**顶对齐**，而 FontIcon 的字形盒与文字的
                            行盒高度不同 → 图标看着比文字高半行。StackPanel 的子元素默认拉伸，
                            图标在「文字那一行的高度」里垂直居中，就与 StatusPill（同一套做法）一致了；
                         ② `MaxWidth` + `TextTrimming`：横排测量给的是无限宽，只写 TextTrimming
                            不会触发省略 —— 必须靠 MaxWidth 把可用宽度钉住，窗口窄时才真的省略，
                            而不是把右边三个按钮顶出去；
                         ③ 字号走 captionSmall 令牌（11，M3 的 labelSmall 档）。 -->
                    <!-- 窗口窄时**主动收起**（`AdaptiveTrigger`）：左组的图标+标题+合集药丸+热键药丸+
                         暂存指示都是内容宽度，免责声明再挤进去就可能把右边三个动作顶出可视区 ——
                         用户报的「显示不全」最可能就是这一种。1240 逻辑像素以下收起它（这台机器 200% DPI、默认窗口 1180 逻辑宽，正好在阈值下）：
                         它信息量最低，且 SPEC §4.4 只要求「全应用范围内存在一处」，
                         主界面收起来不影响（设置页与结果页各自还有自己的那份）。 -->
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="DisclaimerWidthStates">
                            <VisualState x:Name="DisclaimerHidden">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="AppBarDisclaimer.Visibility" Value="Collapsed" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="DisclaimerShown">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1240" />
                                </VisualState.StateTriggers>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <StackPanel x:Name="AppBarDisclaimer" Orientation="Horizontal" Spacing="5"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="AppBarDisclaimer">
                        <FontIcon FontSize="12" Glyph="&#xE946;" VerticalAlignment="Center"
                                  Foreground="{ThemeResource QsOnSurfaceVariantBrush}" />
                        <TextBlock Text="答案由 AI 生成，仅供参考"
                                   FontSize="{StaticResource QsFontSizeCaptionSmall}"
                                   VerticalAlignment="Center"
                                   MaxWidth="150" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource QsOnSurfaceVariantBrush}" />
                    </StackPanel>
                    <Button x:Name="ExportButton" Style="{StaticResource QsIconButtonStyle}"
                            ToolTipService.ToolTip="导出当前合集（Markdown + JSON）" Click="OnExportClick">
                        <FontIcon Glyph="&#xE896;" Style="{StaticResource QsIconFontStyle}" />
                    </Button>
                    <Button x:Name="SearchButton" Style="{StaticResource QsIconButtonStyle}"
                            ToolTipService.ToolTip="搜索历史题目（题干 / 解析）" Click="OnSearchClick">
                        <FontIcon Glyph="&#xE721;" Style="{StaticResource QsIconFontStyle}" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource QsIconButtonStyle}"
                            ToolTipService.ToolTip="设置" Click="OnSettingsClick">
                        <FontIcon Glyph="&#xE713;" Style="{StaticResource QsIconFontStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 多页暂存条**不在这里**了（原来是横在内容区上方的一整条通栏）：
             用户 2026-09-27 要求把它搬到顶栏、放在**热键药丸后面**，默认显示「单张识别」，
             开启多页后显示暂存内容 —— 见顶栏里的 StagingIndicator。
             ⚠️ 搬的时候必须**整块删掉**而不是留一份：`StagingCount` / `ClearStagingButton`
             这些 x:Name 在同一份 XAML 里重复出现会让 XamlCompiler 静默退出 1
             （只有 MSB3073，没有任何文字提示 —— 本仓库记过这个坑）。 -->

        <!-- ============================================================
             主体：296 侧栏 + 1px 分隔线 + 内容区
             ⚠️ `Grid.Row="1"`：页级只有两行（顶栏 / 主体）—— 原来中间那行是暂存条，
             它已经搬到顶栏里（见 StagingIndicator），这一行必须跟着改，否则 Grid.Row 越界。
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 历史记录侧栏（home_page.dart:240-251,657-765） -->
            <Border Grid.Column="0" Background="{ThemeResource QsSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 范围切换 + 计数（用户 2026-09-27 要求）：
                         原来是「历史记录」标题一行 + 右侧一个计数药丸，下面是这一行 ——
                         标题占掉一整行只为了说「这里是历史记录」，而侧栏位置本身已经说明了这件事。
                         现在删掉标题与那个药丸，把计数**挪到两个范围按钮的右边**，
                         文案是「当前 N / 共 M 条记录」：
                           * 当前 N = **当前范围**下真的看得到的条数（切到「全部记录」时 N 也会变）；
                           * 共 M   = 本机库里的总条数。
                         两个数并排才有意义 —— 只给一个总数量时，用户没法判断「切过去能看到多少」。 -->
                    <!-- ⚠️ 这一行**不加上下内边距**，只给 MinHeight（用户报过两次「显示不全」）：
                         `SelectorBarItem` 自身需要 39 逻辑像素（选中指示胶囊就在这个高度里），
                         而我上一轮给行加了 `Padding=0,6,0,6` —— 内容区只剩 34，控件被裁掉一截；
                         我又给 SelectorBar 写了 `Height=28`，压得更扁，等于加重问题。
                         现在的几何：行 46 高（无内边距）→ 控件 39 居中 → 中心 23；
                         计数文字居中 → 23；右侧内容区 34×34 图标按钮居中 → 23。三者同线且不裁切。 -->
                    <Grid Grid.Row="0" Margin="12,0,12,0"
                          MinHeight="{StaticResource QsDimHeaderRowHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SelectorBar x:Name="ScopeSelector" Grid.Column="0"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="ScopeSelector"
                                     SelectionChanged="OnScopeChanged">
                            <SelectorBarItem Text="当前合集" IsSelected="True" />
                            <SelectorBarItem Text="全部记录" />
                        </SelectorBar>
                        <TextBlock x:Name="SessionCountText" Grid.Column="1" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="SessionCountText"
                                   FontSize="{StaticResource QsFontSizeMicro}"
                                   Foreground="{ThemeResource QsOnSurfaceVariantBrush}" />
                    </Grid>

                    <!-- 列表 / 空态 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" Padding="8,0,8,12">
                        <StackPanel x:Name="SessionList" />
                    </ScrollViewer>

                    <controls:EmptyStateView x:Name="SidebarEmpty" Grid.Row="1" Visibility="Collapsed" />

                    <!-- 截屏搜题（OutlinedButton，高 40，图标 18） -->
                    <Button x:Name="CaptureButton" Grid.Row="2" Margin="12,4,12,12"
                            Style="{StaticResource QsOutlinedActionStyle}" Click="OnCaptureClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="18" Glyph="&#xE722;" />
                            <TextBlock Text="截屏搜题" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource QsOutlineBrush}" />

            <!-- 内容区（home_page.dart:996-1013） -->
            <Grid Grid.Column="2" x:Name="ContentPane" SizeChanged="OnContentPaneSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 会话头（home_page.dart:1016-1116） -->
                <!-- `Padding` 的上下与侧栏范围那一行（Margin 12,6,12,6）取同一个值，
                     这样左右两栏的**第一行**在同一条水平线上（用户反馈「内容区上方一行没对齐」）。 -->
                <Grid x:Name="SessionHeader" Grid.Row="0" Padding="16,6,8,6"
                      MinHeight="{StaticResource QsDimHeaderRowHeight}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 时间 + 状态 + 来源 + 题数 + 耗时 + 模型，**同一行**。
                         用户 2026-09-27 要求：把模型显示从「药丸行下面单独一行」移到
                         **左上角识别时间后面** —— 它是这一行里最靠左的元素，
                         「模型」只是一个补充信息，单独占一行会在题目上方多出一条没有内容的横带。 -->
                    <!-- **全部居中**（用户要求「都改成居中」）：WrapPanel 在 Grid 里默认 Stretch
                         拿到整行高度，而它把子元素从**自己顶边**开始排 —— 于是时间/状态/来源/模型
                         全贴着行顶，右侧图标按钮却在行的中线上，同一行左右差半个行高。
                         加 `VerticalAlignment="Center"` 之后 WrapPanel 收成内容高度、整块落在行中线上。 -->
                    <controls:WrapPanel x:Name="HeaderPills" Grid.Column="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                        HorizontalSpacing="8" VerticalSpacing="4" />

                    <!-- 宽 ≥ 620 时用一排图标按钮；窄了换成「更多操作」弹出菜单。
                         每个都给 AutomationId：没有它就没法自动化验证这些动作
                         （agent 看不到图像，控件树是唯一的验收手段）。

                         顺序（左→右）：**会话切换 → 重新生成 → 复制 → 导出 → 删除**。
                         会话切换原来是内容区**底部**那条导航栏（上一次 / 位置 / 下一次 /
                         回到本次），用户 2026-09-27 要求「简化后放到重新生成按钮的前面」，
                         随后又要求**去掉「回到本次」这个功能**（点它会让正在点的按钮位移，
                         体验不值当）。所以这一组只剩：上一个 / 位置 / 下一个，全是固定宽度的东西，
                         点多少次都不会位移。 -->
                    <StackPanel x:Name="HeaderActionsWide" Grid.Column="1" Orientation="Horizontal"
                                Spacing="2" VerticalAlignment="Center">
                        <StackPanel x:Name="HeaderSessionNav" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                            <Button x:Name="NavPrevButton" Style="{StaticResource QsIconButtonStyle}"
                                    AutomationProperties.AutomationId="NavPrevButton"
                                    ToolTipService.ToolTip="上一次识别结果"
                                    Click="OnNavPrevClick">
                                <FontIcon Glyph="&#xE76B;" Style="{StaticResource QsIconFontStyle}" />
                            </Button>
                            <TextBlock x:Name="NavPosition" VerticalAlignment="Center" Margin="6,0,6,0"
                                       AutomationProperties.AutomationId="NavPosition"
                                       FontSize="{StaticResource QsFontSizeCaptionSmall}"
                                       Foreground="{ThemeResource QsOnSurfaceVariantBrush}" />
                            <Button x:Name="NavNextButton" Style="{StaticResource QsIconButtonStyle}"
                                    AutomationProperties.AutomationId="NavNextButton"
                                    ToolTipService.ToolTip="下一次识别结果"
                                    Click="OnNavNextClick">
                                <FontIcon Glyph="&#xE76C;" Style="{StaticResource QsIconFontStyle}" />
                            </Button>
                        </StackPanel>
                        <Button x:Name="HeaderRetryButton" Style="{StaticResource QsIconButtonStyle}"
                                AutomationProperties.AutomationId="HeaderRetryButton"
                                ToolTipService.ToolTip="重新分析（重新调用 AI）"
                                Click="OnRetrySessionClick">
                            <FontIcon Glyph="&#xE72C;" Style="{StaticResource QsIconFontStyle}" />
                        </Button>
                        <Button x:Name="HeaderCopyButton" Style="{StaticResource QsIconButtonStyle}"
                                AutomationProperties.AutomationId="HeaderCopyButton"
                                ToolTipService.ToolTip="复制全部题目与答案"
                                Click="OnCopyAllClick">
                            <FontIcon Glyph="&#xE8C8;" Style="{StaticResource QsIconFontStyle}" />
                        </Button>
                        <Button x:Name="HeaderExportButton" Style="{StaticResource QsIconButtonStyle}"
                                AutomationProperties.AutomationId="HeaderExportButton"
                                ToolTipService.ToolTip="导出本次（Markdown）"
                                Click="OnExportSessionClick">
                            <FontIcon Glyph="&#xE72D;" Style="{StaticResource QsIconFontStyle}" />
                        </Button>
                        <Button x:Name="HeaderDeleteButton" Style="{StaticResource QsIconButtonStyle}"
                                AutomationProperties.AutomationId="HeaderDeleteButton"
                                ToolTipService.ToolTip="删除本次"
                                Click="OnDeleteSessionClick">
                            <FontIcon Glyph="&#xE74D;" Style="{StaticResource QsIconFontStyle}" />
                        </Button>
                    </StackPanel>

                    <Button x:Name="HeaderActionsNarrow" Grid.Column="1" Visibility="Collapsed"
                            VerticalAlignment="Center"
                            Style="{StaticResource QsIconButtonStyle}" ToolTipService.ToolTip="更多操作">
                        <FontIcon Glyph="&#xE712;" Style="{StaticResource QsIconFontStyle}" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <!-- 窄窗口时**会话切换也要在这里**，否则窄了就回不到上一条记录了。
                                     这几项直接复用同一批 Click 处理器，不另写逻辑。 -->
                                <MenuFlyoutItem Text="上一次识别结果" Click="OnNavPrevClick" />
                                <MenuFlyoutItem Text="下一次识别结果" Click="OnNavNextClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="重新分析" Click="OnRetrySessionClick" />
                                <MenuFlyoutItem Text="复制全部" Click="OnCopyAllClick" />
                                <MenuFlyoutItem Text="导出本次（Markdown）" Click="OnExportSessionClick" />
                                <MenuFlyoutItem Text="删除本次" Click="OnDeleteSessionClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- 会话头与题目区之间的分隔线。
                     ⚠️ 它**必须跟着会话头显隐**（用户报过「内容区块的黑框和标题栏下方的黑框
                     重叠，看起来比别的地方宽」）：顶栏自己带一条 `0,0,0,1` 的 QsOutlineBrush 描边，
                     而本行也是同色 1px —— 欢迎态（没有会话头）时两条线**紧挨着**渲染成 2px，
                     看起来就比别处的分隔线粗一倍。会话头不显示时，这条分隔线没有任何东西可分隔。 -->
                <Border x:Name="SessionHeaderDivider" Grid.Row="1"
                        Background="{ThemeResource QsOutlineBrush}" />

                <!-- 题目区 -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="QuestionsScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" Padding="0,6,0,6">
                        <StackPanel x:Name="QuestionList" />
                    </ScrollViewer>

                    <!-- 识别中：_AnalyzingPane（home_page.dart:1324-1403） -->
                    <Grid x:Name="AnalyzingPane" Visibility="Collapsed">
                        <Border Style="{StaticResource QsQuestionCardStyle}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="24" Padding="28">
                            <StackPanel HorizontalAlignment="Center">
                                <ProgressRing IsActive="True" Width="46" Height="46"
                                              Foreground="{ThemeResource QsBrandPrimaryBrush}" />
                                <TextBlock Text="正在识别题目…" Margin="0,20,0,0" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource QsFontDemibold}" FontSize="{StaticResource QsFontSizeSubtitle}"
                                           Foreground="{ThemeResource QsOnSurfaceBrush}" />
                                <TextBlock x:Name="AnalyzingElapsed" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           FontSize="{StaticResource QsFontSizeCaption}" Foreground="{ThemeResource QsOnSurfaceVariantBrush}" />
                                <TextBlock Text="截图已上传，AI 正在读题并给出答案与解析" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" FontSize="{StaticResource QsFontSizeCaption}"
                                           Foreground="{ThemeResource QsOnSurfaceVariantBrush}" />
                                <Button Content="取消" Margin="0,20,0,0" HorizontalAlignment="Center"
                                        Style="{StaticResource QsOutlinedActionStyle}" Click="OnCancelAnalyzeClick" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 欢迎态（无会话，home_page.dart:961-989） -->
                    <Grid x:Name="WelcomePane">
                        <controls:EmptyStateView x:Name="WelcomeState" />
                    </Grid>

                    <!-- 题目空态 / 失败态 -->
                    <Grid x:Name="QuestionsEmptyPane" Visibility="Collapsed">
                        <controls:EmptyStateView x:Name="QuestionsEmpty" />
                    </Grid>
                </Grid>

                <!-- 底部导航条（home_page.dart:1230-1276）**整条不存在了**（连同它上面那条分隔线）：
                     用户 2026-09-27 要求把「上一次 / 下一次 / 回到本次 / 位置」简化后移到
                     内容区右上角「重新生成」按钮前面（见本页 HeaderSessionNav）。
                     意义不只是搬家：识别结果本身是内容，把「翻记录」放在内容**下面**时，
                     用户得先把内容看完才知道下面还有东西；放到顶上与其它动作同一行之后，
                     它变成一眼可见的动作，而且省掉了整条 44px 的常驻高度。
                     免责声明同理，已经常驻在顶栏（AppBarDisclaimer）。 -->
            </Grid>
        </Grid>
    </Grid>
</Page>
